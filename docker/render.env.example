# Copy these settings into Render > Environment; replace all placeholders.
# Do not put real credentials in this tracked example.
APP_NAME=lar_vidu2
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-SERVICE.onrender.com
APP_KEY=
TRUSTED_PROXIES=*

DB_CONNECTION=mysql
DB_HOST=YOUR-AIVEN-HOST
DB_PORT=YOUR-AIVEN-PORT
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=
# Render Secret File named ca.pem (downloaded from Aiven).
MYSQL_ATTR_SSL_CA=/etc/secrets/ca.pem

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=info
PORT=10000
RUN_MIGRATIONS=true

# Demo only: log does NOT deliver verification emails.
# Render Free blocks SMTP ports 25, 465 and 587.
# Configure an HTTPS email provider and its Laravel dependency before real signups.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=lar_vidu2

GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
GHN_SHOP_ID=
GHN_FROM_DISTRICT_ID=
GHN_VERIFY_SSL=true
GHN_DEFAULT_WEIGHT=100
GHN_PACKAGE_LENGTH=10
GHN_PACKAGE_WIDTH=10
GHN_PACKAGE_HEIGHT=2

MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_VERIFY_SSL=true
MOMO_REDIRECT_URL=https://YOUR-SERVICE.onrender.com/payment/momo/callback
MOMO_IPN_URL=https://YOUR-SERVICE.onrender.com/payment/momo/ipn
