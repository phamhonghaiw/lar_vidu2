APP_NAME=Laravel
APP_ENV=local
APP_KEY=*********
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
#CACHE_DRIVER=file
CACHE_STORE=file


PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
#QUEUE_CONNECTION=database
QUEUE_CONNECTION=sync


# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=data@gmail.com
MAIL_PASSWORD=***********
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=data@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"



GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api  
GHN_TOKEN=***********
GHN_SHOP_ID=*********  #id shop của GHN
GHN_VERIFY_SSL=false  #xác thực SSL của GHN
GHN_FROM_DISTRICT_ID=1450   #id quận/huyện của GHN (có thể lấy từ API của GHN)

#giá trị mặc định của đơn hàng khi tạo đơn hàng GHN (có thể thay đổi theo nhu cầu)
GHN_DEFAULT_WEIGHT=100
GHN_PACKAGE_LENGTH=10
GHN_PACKAGE_WIDTH=10
GHN_PACKAGE_HEIGHT=2

